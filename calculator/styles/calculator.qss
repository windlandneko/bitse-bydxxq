QMainWindow,
QDialog {
  background: #f5f3fa;
  color: #29272d;
  font-family: "Microsoft YaHei UI", "Noto Sans CJK SC", sans-serif;
  font-size: 14px;
}

QLineEdit#expressionEdit {
  min-height: 42px;
  padding: 0 12px;
  background: #fbfaff;
  border: 1px solid #dddbe2;
  border-radius: 8px;
  color: #333137;
  font-size: 18px;
  selection-background-color: #0b70c9;
}

QLineEdit#expressionEdit:focus {
  border: 1px solid #0b70c9;
}

QLabel#resultLabel {
  padding: 4px 10px;
  color: #17161a;
  font-size: 27px;
  font-weight: 500;
}

QFrame#keyPanel {
  background: transparent;
}

QPushButton {
  min-height: 38px;
  background: #ffffff;
  border: 1px solid #dedde2;
  border-radius: 7px;
  color: #302e33;
  font-size: 17px;
}

QPushButton:hover {
  background: #f0f6fc;
  border-color: #a9c9e8;
}

QPushButton:pressed {
  background: #dcecf9;
  border-color: #6ca9da;
}

QPushButton#clearButton,
QPushButton#backButton,
QPushButton#divideButton,
QPushButton#multiplyButton,
QPushButton#minusButton,
QPushButton#plusButton {
  background: #f8f7fa;
}

QPushButton#clearButton {
  color: #b13a45;
}

QPushButton#equalButton {
  background: #0b70c9;
  border-color: #0b70c9;
  color: white;
  font-size: 22px;
}

QPushButton#equalButton:hover {
  background: #0965b6;
}

QPushButton#equalButton:pressed {
  background: #07579d;
}

QPushButton#dragShadow {
  background: #ffffff;
  border: 1px solid #8bb9df;
  color: #0b70c9;
}

QGroupBox#financeGroup {
  margin-top: 10px;
  padding-top: 10px;
  background: #fbfaff;
  border: 1px solid #dedde4;
  border-radius: 9px;
  font-weight: 500;
}

QGroupBox#financeGroup::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 5px;
  color: #4a474f;
}

QDoubleSpinBox,
QSpinBox {
  min-height: 28px;
  padding: 0 7px;
  background: #ffffff;
  border: 1px solid #d9d7de;
  border-radius: 6px;
  selection-background-color: #0b70c9;
}

QDoubleSpinBox:focus,
QSpinBox:focus {
  border-color: #0b70c9;
}

QLabel#financeResultLabel {
  color: #0b70c9;
  font-size: 20px;
  font-weight: 600;
}

QLabel#financeResultTitleLabel,
QLabel#parameterTitleLabel {
  color: #74707a;
  font-size: 13px;
}

QLabel#parameterLabel {
  color: #4b4850;
  font-size: 13px;
}

QPushButton#financeButton {
  min-height: 28px;
  padding: 0 14px;
  background: #edf5fc;
  border-color: #b8d4ec;
  color: #075da9;
  font-size: 14px;
}

QDialog QLabel#titleLabel {
  color: #17161a;
  font-size: 19px;
  font-weight: 600;
}

QDialogButtonBox QPushButton {
  min-width: 72px;
  min-height: 30px;
  font-size: 14px;
}
